				"--build",
				"--preset",
				"build-corgogame-vs2022-sim",
				"--config",
				"Debug"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "CMake: clean (Debug)",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"--preset",
				"build-corgogame-vs2022-sim",
				"--config",
				"Debug",
				"--target",
				"clean"
			],
			"isBackground": false,
			"problemMatcher": [],
