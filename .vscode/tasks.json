				"build-vs2022-sim",
				"--config",
				"Debug"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "CMake: build (Release)",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"--preset",
				"build-vs2022-sim",
				"--config",
				"Release"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Set Up Env Variables",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-ExecutionPolicy",
				"Bypass",
				"-File",
