{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "CMake: build (Debug)",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"--preset",
				"build-corgogame-vs2022-sim",
				"--config",
				"Debug"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "CMake: clean (Debug)",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"--preset",
				"build-corgogame-vs2022-sim",
				"--config",
				"Debug",
				"--target",
				"clean"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "CMake: rebuild (Debug)",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"--preset",
				"build-corgogame-vs2022-sim",
				"--config",
				"Debug",
				"--clean-first"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "CMake: build corgogame (Debug, close simulator first)",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"Set-Location '${workspaceFolder}/corgogame'; Get-Process PlaydateSimulator -ErrorAction SilentlyContinue | Stop-Process -Force; cmake --preset corgogame-vs2022-sim; cmake --build --preset build-corgogame-vs2022-sim --config Debug"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "CMake: build corgogame2 (Debug, close simulator first)",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"Set-Location '${workspaceFolder}/corgogame'; Get-Process PlaydateSimulator -ErrorAction SilentlyContinue | Stop-Process -Force; cmake --preset corgogame2-vs2022-sim; cmake --build --preset build-corgogame2-vs2022-sim --config Debug"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Set Up Env Variables",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/corgo-engine/scripts/set-up-env-vars.ps1"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"type": "cmake",
			"label": "CMake: configure",
			"command": "configure",
			"problemMatcher": [],
			"detail": "CMake template configure task"
		},
		{
			"label": "MCP: bootstrap knowledge servers",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"Set-Location '${workspaceFolder}'; Set-Location 'tools/corgo-mcp-knowledge'; npm install; npm run self-check; Set-Location '../playdate-mcp'; npm install; npm run self-check"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		}
	]
}